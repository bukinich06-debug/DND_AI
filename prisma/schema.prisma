generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// Тип локации в иерархии мира
enum LocationKind {
  region
  settlement
  district
  building
  room
  dungeon
  wilderness
  other
}

/// Уровень раскрытия знания NPC: сразу / под проверкой / скрыто
enum KnowledgeReveal {
  open
  check
  hidden
}

/// Тип воспоминания NPC
enum MemoryKind {
  episode
  fact
  favor
  grievance
  promise
}

/// Категория предмета
enum ItemKind {
  weapon
  armor
  shield
  tool
  gear
  consumable
  treasure
  key
  junk
  other
}

/// Слот экипировки: доспех или рука; null в Item = сумка
enum EquipSlot {
  armor
  mainHand
  offHand
}

/// Редкость предмета
enum ItemRarity {
  common
  uncommon
  rare
  veryRare
  legendary
  artifact
}

/// Статус квеста
enum QuestStatus {
  available
  active
  done
  failed
}

/// Роль NPC в квесте
enum QuestNpcRole {
  giver
  participant
  target
  witness
}

/// Тип кубика
enum DiceKind {
  d4
  d6
  d8
  d10
  d12
  d20
  d100
}

/// Слот игровых суток
enum TimeOfDay {
  morning
  noon
  afternoon
  evening
  lateEvening
  midnight
  night
}

/// Статус отложенного события мира
enum WorldEventStatus {
  pending
  done
}

/// Как задано время события: ближайший слот или конкретный день
enum WorldEventWhen {
  nextSlot
  onDay
}

/// Кампания — корень игрового мира
model Campaign {
  id               String            @id @default(cuid())
  name             String
  description      String?
  dayIndex         Int               @default(1)
  timeOfDay        TimeOfDay         @default(morning)
  players          Player[]
  locations        Location[]
  locationLinks    LocationLink[]
  npcs             Npc[]
  items            Item[]
  quests           Quest[]
  monsterInstances MonsterInstance[]
  diceRolls        DiceRoll[]
  worldEvents      WorldEvent[]

  @@map("campaign")
}

/// Игрок (PC) — лист персонажа по правилам D&D 2024
model Player {
  id               String  @id @default(cuid())
  campaignId       String
  name             String
  species          String
  className        String
  subclass         String?
  background       String
  level            Int
  xp               Int?
  alignment        String?
  str              Int
  dex              Int
  con              Int
  int              Int
  wis              Int
  cha              Int
  hpMax            Int
  hpCurrent        Int
  hpTemp           Int     @default(0)
  hitDie           String
  hitDiceLeft      Int
  ac               Int
  speed            Int
  initiativeBonus  Int?
  proficiencyBonus Int
  inspiration      Boolean @default(false)
  deathSaveSuccess Int     @default(0)
  deathSaveFail    Int     @default(0)
  armorProf        String[]
  weaponProf       String[]
  toolProf         String[]
  languages        String[]
  skillProf        String[]
  skillExpertise   String[]
  saveProf         String[]
  features         Json?
  spells           Json?
  notes            String?
  portraitUrl      String?
  coinsCp              Int      @default(0)
  conditions           String[] @default([])
  exhaustionLevel      Int      @default(0)
  dead                 Boolean  @default(false)
  locationId           String?
  travelDestinationId  String?
  travelRoute          Json?
  travelLegIndex       Int?
  travelDaysLeft       Int?
  shortRestsToday      Int      @default(0)
  shortRestDayIndex    Int      @default(1)

  campaign          Campaign  @relation(fields: [campaignId], references: [id])
  location          Location? @relation("PlayerLocation", fields: [locationId], references: [id])
  travelDestination Location? @relation("PlayerTravelDestination", fields: [travelDestinationId], references: [id])
  items             Item[]
  diceRolls         DiceRoll[]
  npcRelations      NpcRelation[]
  npcMemories       NpcMemory[]
  worldEvents       WorldEvent[]

  @@map("player")
}

/// Локация — место в мире (город, здание, комната и т.п.), дерево через parentId
model Location {
  id          String       @id @default(cuid())
  campaignId  String
  parentId    String?
  kind        LocationKind
  name        String
  summary     String
  description String
  features    String
  isSecret    Boolean      @default(false)
  tags        String[]

  campaign           Campaign       @relation(fields: [campaignId], references: [id])
  parent             Location?      @relation("LocationTree", fields: [parentId], references: [id])
  children           Location[]     @relation("LocationTree")
  npcs               NpcLocation[]
  items              Item[]
  quests             Quest[]
  playersHere        Player[]       @relation("PlayerLocation")
  playersTravelingTo Player[]       @relation("PlayerTravelDestination")
  linksFrom          LocationLink[] @relation("LocationLinkFrom")
  linksTo            LocationLink[] @relation("LocationLinkTo")
  worldEvents        WorldEvent[]

  @@map("location")
}

/// Ребро пути между локациями (дорога / переход), days — длительность в днях
model LocationLink {
  id         String  @id @default(cuid())
  campaignId String
  fromId     String
  toId       String
  days       Int
  label      String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  from     Location @relation("LocationLinkFrom", fields: [fromId], references: [id])
  to       Location @relation("LocationLinkTo", fields: [toId], references: [id])

  @@unique([fromId, toId])
  @@map("location_link")
}

/// NPC — неигровой персонаж: внешность, характер, речь, привычки
model Npc {
  id               String  @id @default(cuid())
  campaignId       String
  name             String
  title            String?
  appearance       String
  personality      String
  speech           String
  habits           String
  attitude         String?
  dmNotes          String?
  coinsCp          Int     @default(0)
  shopSpecialtyKey String?

  campaign  Campaign       @relation(fields: [campaignId], references: [id])
  locations NpcLocation[]
  knowledge NpcKnowledge[]
  items     Item[]
  quests    QuestNpc[]
  statBlock NpcStatBlock?
  diceRolls DiceRoll[]
  relations       NpcRelation[]
  memories        NpcMemory[]      @relation("NpcOwnsMemory")
  aboutInMemories NpcMemory[]      @relation("NpcAboutMemory")
  knows           NpcAcquaintance[] @relation("NpcKnows")
  knownBy         NpcAcquaintance[] @relation("NpcKnownBy")
  worldEvents     WorldEvent[]

  @@map("npc")
}

/// Знакомство NPC↔NPC (однонаправленно: npc знает otherNpc)
model NpcAcquaintance {
  npcId      String
  otherNpcId String
  note       String?

  npc       Npc @relation("NpcKnows", fields: [npcId], references: [id], onDelete: Cascade)
  otherNpc Npc @relation("NpcKnownBy", fields: [otherNpcId], references: [id], onDelete: Cascade)

  @@id([npcId, otherNpcId])
  @@map("npc_acquaintance")
}

/// Боевой профиль NPC (статблок): HP, AC, сопротивления, атаки
model NpcStatBlock {
  id                  String   @id @default(cuid())
  npcId               String   @unique
  size                String?
  creatureType        String?
  challengeRating     String?
  proficiencyBonus    Int?
  str                 Int
  dex                 Int
  con                 Int
  int                 Int
  wis                 Int
  cha                 Int
  hpMax               Int
  hpCurrent           Int
  ac                  Int
  speed               Int
  initiativeBonus     Int?
  saveProf            String[]
  resistances         String[]
  immunities          String[]
  vulnerabilities     String[]
  conditionImmunities String[]
  senses              String[]
  languages           String[]
  traits              Json?
  actions             Json?
  reactions           Json?
  legendaryActions    Json?

  npc Npc @relation(fields: [npcId], references: [id], onDelete: Cascade)

  @@map("npc_stat_block")
}

/// Экземпляр монстра — живой боец, созданный из справочника
model MonsterInstance {
  id                  String   @id @default(cuid())
  campaignId          String
  catalogKey          String
  name                String
  hpMax               Int
  hpCurrent           Int
  ac                  Int
  speed               Int
  initiativeBonus     Int?
  str                 Int
  dex                 Int
  con                 Int
  int                 Int
  wis                 Int
  cha                 Int
  saveProf            String[]
  resistances         String[]
  immunities          String[]
  vulnerabilities     String[]
  conditionImmunities String[]
  conditions          String[] @default([])

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("monster_instance")
}

/// Связь NPC с локациями (где живёт, работает, бывает)
model NpcLocation {
  npcId      String
  locationId String
  role       String?
  isPrimary  Boolean @default(false)

  npc      Npc      @relation(fields: [npcId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([npcId, locationId])
  @@map("npc_location")
}

/// Знание NPC: open / check / hidden — что скажет сразу, под проверкой или не выдаст
model NpcKnowledge {
  id        String          @id @default(cuid())
  npcId     String
  title     String
  content   String
  reveal    KnowledgeReveal
  skillHint String?
  dc        Int?
  questId   String?

  npc   Npc    @relation(fields: [npcId], references: [id])
  quest Quest? @relation(fields: [questId], references: [id])

  @@map("npc_knowledge")
}

/// Отношение NPC к конкретному игроку (−100…100)
model NpcRelation {
  npcId    String
  playerId String
  score    Int     @default(0)
  note     String?

  npc    Npc    @relation(fields: [npcId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([npcId, playerId])
  @@map("npc_relation")
}

/// Сжатое воспоминание NPC (факт / эпизод / должок / обида / обещание)
model NpcMemory {
  id          String     @id @default(cuid())
  npcId       String
  playerId    String?
  aboutNpcId String?
  summary     String
  kind        MemoryKind
  importance  Int        @default(3)

  npc       Npc     @relation("NpcOwnsMemory", fields: [npcId], references: [id], onDelete: Cascade)
  player    Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  aboutNpc Npc?    @relation("NpcAboutMemory", fields: [aboutNpcId], references: [id], onDelete: SetNull)

  @@map("npc_memory")
}

/// Предмет — оружие, доспех, инструмент, ключ, мусор; владелец: игрок, NPC или локация
model Item {
  id          String      @id @default(cuid())
  campaignId  String
  name        String
  kind        ItemKind
  rarity      ItemRarity?
  description String
  weight      Float?
  valueCp     Int?
  coinsCp     Int         @default(0)
  quantity    Int         @default(1)
  catalogKey  String?
  isMagical   Boolean     @default(false)
  properties  Json?
  equipSlot   EquipSlot?
  playerId    String?
  npcId       String?
  locationId  String?

  campaign Campaign  @relation(fields: [campaignId], references: [id])
  player   Player?   @relation(fields: [playerId], references: [id])
  npc      Npc?      @relation(fields: [npcId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@map("item")
}

/// Квест — задание кампании
model Quest {
  id          String      @id @default(cuid())
  campaignId  String
  title       String
  description String
  status      QuestStatus @default(available)
  locationId  String?

  campaign  Campaign       @relation(fields: [campaignId], references: [id])
  location  Location?      @relation(fields: [locationId], references: [id])
  npcs      QuestNpc[]
  knowledge NpcKnowledge[]

  @@map("quest")
}

/// Роль NPC в квесте: даёт, участвует, цель, свидетель
model QuestNpc {
  questId String
  npcId   String
  role    QuestNpcRole

  quest Quest @relation(fields: [questId], references: [id])
  npc   Npc   @relation(fields: [npcId], references: [id])

  @@id([questId, npcId, role])
  @@map("quest_npc")
}

/// История броска кубика
model DiceRoll {
  id         String   @id @default(cuid())
  campaignId String
  die        DiceKind
  value      Int
  note       String?
  playerId   String?
  npcId      String?
  rolledAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  player   Player?  @relation(fields: [playerId], references: [id])
  npc      Npc?     @relation(fields: [npcId], references: [id])

  @@map("dice_roll")
}

/// Отложенная встреча / событие мира
model WorldEvent {
  id         String           @id @default(cuid())
  campaignId String
  status     WorldEventStatus @default(pending)
  whenKind   WorldEventWhen
  slot       TimeOfDay
  dayIndex   Int?
  locationId String
  playerId   String
  npcId      String?
  title      String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id])
  npc      Npc?     @relation(fields: [npcId], references: [id])

  @@index([campaignId, status])
  @@map("world_event")
}
